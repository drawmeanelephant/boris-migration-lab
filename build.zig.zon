.{
    .name = .boris_migration_lab,
    .version = "0.1.0",
    .fingerprint = 0x3e8a1154a7c8f697, // generated by zig for this package identity
    .minimum_zig_version = "0.16.0",
    // The laboratory links Boris's parser in-process as the astro-import-apply
    // final gate (docs/contracts/astro-import-apply.md). It is consumed as a
    // package, never by a relative `../../src` path, so the tree stays
    // forkable.
    //
    // Standalone pin: URL + hash of released tag v0.8.2 — the first Boris
    // release that carries the `parser` package module (published by
    // drawmeanelephant/boris#841; cut 2026-09-02). Advance the pin at the
    // next Boris release; see README "Boris pins".
    .dependencies = .{
        .boris = .{
            .url = "https://github.com/drawmeanelephant/boris/archive/refs/tags/v0.8.2.tar.gz",
            .hash = "boris-0.8.2-_G6nDQu8cACHNTv2O7h5ePeepUEMg1Wo7Iq5gvS9KQue",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "wordpress.zig",
        "starlight.zig",
        "astro_import_plan.zig",
        "astro_import_apply.zig",
        "instagram.zig",
        "obsidian.zig",
        "notion.zig",
        "filed.zig",
        "filed_scan.zig",
        "asset_filename.zig",
        "theme_archaeology.zig",
        "theme_materialize.zig",
        "wordpress_theme.zig",
        "product_boris.zig",
        "layouts",
        "link_audit.zig",
        "frontmatter_review.zig",
        "migration_semantics.zig",
        "publication.zig",
        "archaeology.zig",
        "fixtures",
        "schema-validation",
        "README.md",
        ".gitignore",
    },
}
