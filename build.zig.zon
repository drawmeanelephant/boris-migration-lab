.{
    .name = .boris_migration_lab,
    .version = "0.1.0",
    .fingerprint = 0x3e8a1154a7c8f697, // generated by zig for this package identity
    .minimum_zig_version = "0.17.0",
    // The laboratory links Boris's parser in-process as the astro-import-apply
    // final gate (docs/contracts/astro-import-apply.md). It is consumed as a
    // package, never by a relative `../../src` path, so the tree stays
    // forkable.
    //
    // Standalone pin: URL + hash of Boris main commit 2eb2c915 — the Zig 0.17
    // toolchain migration (drawmeanelephant/boris#1026), which also repins the
    // transitive Oliver dependency to its 0.17 revision. Return to a released
    // tag pin at the next Boris release; see README "Boris pins".
    .dependencies = .{
        .boris = .{
            .url = "https://github.com/drawmeanelephant/boris/archive/2eb2c915.tar.gz",
            .hash = "boris-0.8.2-_G6nDZ4PeQDPobpw5vQ6nLwHO2CIn33AFe7fJpCoPySd",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "wordpress.zig",
        "starlight.zig",
        "astro_import_plan.zig",
        "astro_import_apply.zig",
        "instagram.zig",
        "obsidian.zig",
        "notion.zig",
        "filed.zig",
        "filed_scan.zig",
        "asset_filename.zig",
        "theme_archaeology.zig",
        "theme_materialize.zig",
        "wordpress_theme.zig",
        "product_boris.zig",
        "layouts",
        "link_audit.zig",
        "frontmatter_review.zig",
        "migration_semantics.zig",
        "publication.zig",
        "archaeology.zig",
        "fixtures",
        "schema-validation",
        "README.md",
        ".gitignore",
    },
}
