.{
    .name = .boris_migration_lab,
    .version = "0.1.0",
    .fingerprint = 0x3e8a1154a7c8f697, // generated by zig for this package identity
    .minimum_zig_version = "0.16.0",
    // The laboratory links Boris's parser in-process as the astro-import-apply
    // final gate (docs/contracts/astro-import-apply.md). It is consumed as a
    // package, never by a relative `../../src` path, so the tree stays
    // forkable.
    //
    // Standalone pin: URL + hash at a Boris commit that publishes the `parser`
    // package module (the freeze commit of PR drawmeanelephant/boris#841).
    // Re-pin to the next released Boris tag (e.g. v0.9.x) when one exists;
    // see README "Boris pins".
    .dependencies = .{
        .boris = .{
            .url = "https://github.com/drawmeanelephant/boris/archive/f6a4973.tar.gz",
            .hash = "boris-0.8.1-_G6nDQoNjgAaqIOnfyzVxOumKVgpCVDD6nBb708y-C2k",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "wordpress.zig",
        "starlight.zig",
        "astro_import_plan.zig",
        "astro_import_apply.zig",
        "instagram.zig",
        "obsidian.zig",
        "notion.zig",
        "filed.zig",
        "filed_scan.zig",
        "asset_filename.zig",
        "theme_archaeology.zig",
        "theme_materialize.zig",
        "wordpress_theme.zig",
        "product_boris.zig",
        "layouts",
        "link_audit.zig",
        "frontmatter_review.zig",
        "migration_semantics.zig",
        "publication.zig",
        "archaeology.zig",
        "fixtures",
        "schema-validation",
        "README.md",
        ".gitignore",
    },
}
