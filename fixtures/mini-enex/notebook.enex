    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note>
      <h1>Architecture Overview</h1>
      <p>This synthetic note covers <b>bold</b>, <i>italic</i>, <strong>strong</strong>, and <em>emphasized</em> inline markup plus <code>inline_code()</code>.</p>
      <div>A div paragraph linking to <a href="https://example.com/spec">Example Spec</a>.</div>
      <h2>Key Components</h2>
      <ul>
        <li>Notebook XML container</li>
        <li>ENML content body</li>
      </ul>
      <ol>
        <li>Parse export metadata</li>
        <li>Match resources by decoded MD5</li>
      </ol>
      <h3>Checklist and Snippets</h3>
      <div><en-todo checked="true"/>Verify MD5 media binding</div>
      <div><en-todo checked="false"/>Review encrypted blocks</div>
      <pre>fn main() { return 0; }</pre>
      <blockquote><p>Quoted design note for ENEX conversion.</p></blockquote>
      <table>
        <tr><th>Construct</th><th>Handling</th></tr>
        <tr><td>ENML table</td><td>Markdown table</td></tr>
      </table>
      <div><en-media type="image/png" hash="78dc75bbdaf576f1f4f214d0f0f1b1ea"/></div>
      <div><en-media type="text/plain" hash="d16d8ec1f1e82c2e97702fbf474c903d"/></div>
    </en-note>]]></content>
